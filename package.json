    "@cloudflare/workers-types": "5.20261114.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.12.0",
    "cheerio": "1.2.0",
    "eslint": "10.15.0",
    "lighthouse": "13.6.0",
    "typescript": "6.0.3",
