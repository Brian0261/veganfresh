---
import Site from '../layouts/Site.astro';
import EditorialPhoto from '../components/EditorialPhoto.astro';
import { pages } from '../config/pages';
---
<Site page="missing">
  <section class="section missing">
    <div class="wrap missing-grid">
      <div>
        <p class="eyebrow">Página no encontrada</p>
        <p class="error-code" aria-hidden="true">404<span>.</span></p>
        <h1>{pages.missing.h1}</h1>
        <p>El enlace puede haber cambiado o estar incompleto. Puedes volver al inicio o contarnos qué productos necesita tu empresa.</p>
        <div class="actions">
          <a class="button" href="/">Volver al inicio <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/productos/">Explorar productos <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/cotizar/">Solicitar cotización</a>
        </div>
      </div>
      <div class="missing-photo"><EditorialPhoto name="leaf-detail" sizes="(min-width: 1440px) 490px, 40vw" decorative /></div>
    </div>
  </section>
</Site>
