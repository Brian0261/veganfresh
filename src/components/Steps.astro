---
interface Props { items: readonly (readonly [string, string])[]; columns?: boolean; editorial?: boolean }
const { items, columns = false, editorial = false } = Astro.props;
---
<ol class:list={['steps', { 'steps-columns': columns, 'steps-editorial': editorial }]} role="list">
  {items.map(([title, description], index) => (
    <li>
      <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <div><h3>{title}</h3>{description && <p>{description}</p>}</div>
    </li>
  ))}
</ol>
