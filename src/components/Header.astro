---
import { pages, primaryNavigation, type PageKey } from '../config/pages';
interface Props { current: PageKey }
const { current } = Astro.props;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="VEGANFRESH, inicio">
      <picture>
        <source srcset="/assets/brand/logo-primary.webp" type="image/webp" />
        <img src="/assets/brand/logo-primary.png" width="1971" height="318" alt="VEGANFRESH" />
      </picture>
    </a>
    <nav class="desktop-nav" aria-label="Navegación principal">
      {primaryNavigation.map(key => (
        <a href={pages[key].path} aria-current={current === key ? 'page' : undefined}>{pages[key].label}</a>
      ))}
    </nav>
    <a class="button header-quote" href="/cotizar/" aria-current={current === 'cotizar' ? 'page' : undefined}>
      Solicitar cotización <span aria-hidden="true">↗</span>
    </a>
    <details class="mobile-menu">
      <summary aria-controls="mobile-navigation">Menú</summary>
      <nav id="mobile-navigation" aria-label="Navegación principal">
        {primaryNavigation.map(key => (
          <a href={pages[key].path} aria-current={current === key ? 'page' : undefined}>{pages[key].label}</a>
        ))}
        <a class="button" href="/cotizar/" aria-current={current === 'cotizar' ? 'page' : undefined}>
          Solicitar cotización <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  const trigger = menu?.querySelector('summary');
  if (menu && trigger) {
    const sync = () => trigger.setAttribute('aria-expanded', String(menu.open));
    sync();
    menu.addEventListener('toggle', sync);
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.open && menu.contains(document.activeElement)) {
        menu.open = false;
        trigger.focus();
      }
    });
    document.addEventListener('pointerdown', event => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  }
</script>
